# Copy to .env.local for development. On the VPS these come from the
# systemd unit or the container's env_file, never from a file you edit
# over SSH — see docs/DEPLOY.md.

# --- Database -------------------------------------------------------------
# The VPS runs five Postgres instances, each inside its own compose project
# and none published to the host. Touchline follows that pattern: its own
# postgres:16-alpine container on the project's private network.
# See docs/VPS-INVENTORY.md for why, rather than sharing an existing one.
#
# In the container, the host is the service name:
DATABASE_URL=postgres://touchline:CHANGEME@touchline-db:5432/touchline
# Locally, point at whatever you run on your own machine:
# DATABASE_URL=postgres://touchline:CHANGEME@127.0.0.1:5432/touchline
DATABASE_POOL_MAX=10

# --- Auth -----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Must be the public https URL in production, not the container's port.
AUTH_URL=http://localhost:3000

# Mixed into every OTP hash. Rotating it invalidates all outstanding codes,
# which is the point. openssl rand -hex 32
OTP_PEPPER=

# --- One-time code delivery -----------------------------------------------
# log     — written to the server log. No setup, but you read codes in a terminal.
# mailpit — posted to a local Mailpit, so you read them in a browser.
# sms     — a real provider. The only value production accepts; the app
#           refuses to start on anything else.
OTP_TRANSPORT=mailpit

# Touchline's OWN Mailpit, not any other project's. Run it with:
#   docker run --name touchline-mailpit \
#     -p 127.0.0.1:1026:1025 -p 127.0.0.1:8026:8025 \
#     -d axllent/mailpit:latest
# Inbox at http://localhost:8026
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1026

# For OTP_TRANSPORT=sms. Not implemented yet — see src/lib/otp-delivery.ts.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Sports feed ----------------------------------------------------------
# Provider is a flag, not a hardcoded import: you will change provider
# mid-season when one gets expensive or drops a league.
SPORTS_PROVIDER=api-football
SPORTS_API_KEY=
SPORTS_API_BASE=

# --- Cron -----------------------------------------------------------------
# Shared secret for the ingest and scoring endpoints, so they are not open
# to anyone who finds the URL.
CRON_SECRET=
